{
  "module": "environment",
  "version": "4.0.0",
  "dependsOn": ["core", "configuration"],
  "legacyAliases": ["planning_followup_environment"],
  "pathPatterns": ["#(?:^|/)[^/]*(?:calendar|resource|team|capacity|surbook|incompatible|support|contact|organization|intervention|prospect|otherclient)#i"],
  "classPatterns": ["/(?:Calendar|Resource|Team|Capacity|Surbooking|Incompatible|Support|Contact|Client|Prospect|Organization|Intervention)/i"],
  "ownedClasses": ["Client", "Contact", "OtherClient", "Prospect", "ProspectEvent"],
  "handlerMappings": {
    "tool:removeGenericBankOffDay": {"action": "environment.calendar.update", "classes": ["CalendarBankOffDays"]},
    "tool:copyBankOffDaysOfCalendarDefinition": {"action": "environment.calendar.bank_holidays.apply", "classes": ["CalendarBankOffDays", "CalendarDefinition"]},
    "tool:removeOtherClient": {"action": "tools.relationship.unlink", "classes": ["OtherClient"]},
    "tool:saveGenericBankOffDays": {"action": "environment.calendar.update", "classes": ["CalendarBankOffDays"]},
    "tool:saveOtherClient": {"action": "tools.relationship.link", "classes": ["OtherClient", "*refType"]},
    "tool/saveProspectEvent.php": {"action": "environment.prospect.event.manage", "test": "coverage.environment.prospect.event.manage"},
    "tool/saveProspectTransform.php": {"action": "environment.prospect.convert", "test": "coverage.environment.prospect.convert"},
    "tool/switchOtherClient.php": {"action": "environment.client_relationship.promote", "test": "coverage.environment.client_relationship.promote"}
  }
}
