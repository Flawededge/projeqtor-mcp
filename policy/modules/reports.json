{
  "module": "reports",
  "version": "4.0.0",
  "dependsOn": ["core", "configuration", "tools"],
  "legacyAliases": ["steering_reports"],
  "pathPatterns": ["#^report/#i", "#(?:^|/)[^/]*(?:report|dashboard|chart|favorite)#i"],
  "classPatterns": ["/(?:Report|Dashboard|Favorite|Today)/i"],
  "ownedClasses": [
    "AutoSendReport", "Favorite", "FavoriteParameter", "HabilitationReport",
    "ModuleReport", "Report", "ReportCategory", "ReportLayout", "ReportParameter",
    "Today", "TodayParameter"
  ],
  "handlerMappings": {
    "tool/backupReportLayout.php": {"action": "reports.layout.manage", "test": "reports.layout.manage"},
    "tool/getParamDashboard.php": {"action": "reports.dashboard.read", "test": "reports.dashboard.read"},
    "tool/jsonProjectDashboard.php": {"action": "reports.dashboard.read", "test": "reports.dashboard.read"},
    "tool/jsonProjectDashboardDetail.php": {"action": "reports.dashboard.read", "test": "reports.dashboard.read"},
    "tool/moveReportLayoutColumn.php": {"action": "reports.layout.manage", "test": "reports.layout.manage"},
    "tool/removeFavoriteReport.php": {"action": "reports.favorite.delete", "test": "reports.favorite.delete"},
    "tool/removeReportLayout.php": {"action": "reports.layout.delete", "test": "reports.layout.delete"},
    "tool/saveAutoSendReport.php": {"action": "reports.schedule", "test": "reports.schedule"},
    "tool/saveReportAsFavorite.php": {"action": "reports.favorite.manage", "test": "reports.favorite.manage"},
    "tool/saveReportFavoriteOrder.php": {"action": "reports.favorite.manage", "test": "reports.favorite.manage"},
    "tool/saveReportInToday.php": {"action": "reports.dashboard.pin", "test": "reports.dashboard.pin"},
    "tool/saveReportLayout.php": {"action": "reports.layout.manage", "test": "reports.layout.manage"},
    "tool/saveTodayDeleteReport.php": {"action": "reports.dashboard.unpin", "test": "reports.dashboard.unpin"},
    "tool/shareReportLayout.php": {"action": "reports.layout.manage", "test": "reports.layout.manage"},
    "tool:saveNewTodayParameters": {"action": "reports.dashboard.unpin", "classes": ["Today"]}
  },
  "handlerHandoffs": {
    "tool/exportLeaveCalendarOfDashboardEmployeeManager.php": "hr",
    "view/dashboardEmployeeManager.php": "hr",
    "view/dashboardRequirementMain.php": "configuration",
    "view/dashboardTicketMain.php": "configuration"
  }
}
