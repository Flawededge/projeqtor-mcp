{
  "module": "configuration",
  "version": "4.0.0",
  "dependsOn": ["core"],
  "legacyAliases": ["hr_tools_configuration"],
  "pathPatterns": ["#(?:^|/)[^/]*(?:adminfunctionalities|user|profile|access|workflow|module|parameter|filter|layout|cron|status|habilitation|menu|columnselector|oauth|password|installauto|plugin)#i", "#^(?:api|sso|plugin)/#i"],
  "classPatterns": ["/(?:User|Profile|Access|Workflow|Module|Parameter|Filter|Layout|Cron|Status|Habilitation|Menu|ColumnSelector|OAuth|SSO|Plugin)/i"],
  "readOnlyHandlers": ["tool:addDynamicFilterClause", "tool:addFilterClause", "tool:backupFilter", "tool:backupLayout", "tool:displayFilterClause", "tool:removeFilterClause", "tool:removeFilterGroup", "tool:selectStoredLayout", "tool:updateFilterGroup"],
  "genericCrudHandlers": {"tool:deleteOAuthClient": ["OAuthClient"]},
  "handlerMappings": {
    "tool:commonFilter": {"action": "configuration.view.manage", "classes": ["Filter"]},
    "tool:defaultFilter": {"action": "configuration.view.manage", "classes": ["Parameter"]},
    "tool:dynamicDialogDynamicFilter": {"action": "configuration.view.manage", "classes": ["FilterCriteria"]},
    "tool:moveFilterColumn": {"action": "configuration.view.manage", "classes": ["Filter"]},
    "tool:moveListColumn": {"action": "configuration.view.manage", "classes": ["ColumnSelector"]},
    "tool:removeLayoutGroup": {"action": "configuration.view.manage", "classes": ["LayoutGroup", "LayoutGroupUser"]},
    "tool:saveAdminConfigParam": {"action": "configuration.parameter.set", "classes": ["Parameter"]},
    "tool:saveCheckboxes": {"action": "configuration.view.manage", "classes": ["ColumnSelector"]},
    "tool:saveCustomMenu": {"action": "configuration.view.manage", "classes": ["MenuCustom"]},
    "tool:saveCustomMenuOrder": {"action": "configuration.view.manage", "classes": ["MenuCustom"]},
    "tool:saveFavoriteProjectList": {"action": "configuration.view.manage", "classes": ["FavoriteProjectList", "FavoriteProjectItem"]},
    "tool:saveFilterToFavoriteProjectList": {"action": "configuration.view.manage", "classes": ["Filter", "FavoriteProjectList", "Parameter"]},
    "tool:saveGroup": {"action": "configuration.view.manage", "classes": ["LayoutGroup", "LayoutGroupUser"]},
    "tool:saveMoveColumn": {"action": "configuration.view.manage", "classes": ["ColumnSelector"]},
    "tool:saveRestrictTypes": {"action": "configuration.access.manage", "classes": ["RestrictType"]},
    "tool:saveSelectedColumn": {"action": "configuration.view.manage", "classes": ["ColumnSelector"]},
    "tool:setTimelineItem": {"action": "configuration.view.manage", "classes": ["TimelineItem"]},
    "tool:storeValueHidden": {"action": "configuration.access.manage", "classes": ["ListHideValue"]},
    "view:menuUserScreenOrganization": {"action": "configuration.view.manage", "classes": ["Parameter"]},
    "view:dashboardRequirementMain": {"action": "configuration.parameter.set", "classes": ["Parameter"]},
    "view:dashboardTicketMain": {"action": "configuration.parameter.set", "classes": ["Parameter"]},
    "tool:adminFunctionalities": {"action": "configuration.admin.execute", "classes": ["Alert", "Mail", "Audit", "Notification", "Logfile", "Parameter", "PlanningElement", "WaitingUpdate", "User", "*Referencable"]},
    "tool:cronExecutionStandard": {"action": "cron.configure", "classes": ["CronExecution", "Parameter"]},
    "view:menuNewGuiLeft": {"action": "configuration.plugin_update.notify", "classes": ["Notification"]}
  }
}
