MCP_OAUTH_ALLOWED_DOMAINS=hikoterra.com,pcnzl.com
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
CLAUDE_OAUTH_REDIRECT_URI=
KEYCLOAK_PUBLIC_URL=https://conceptpower.ddns.net/projeqtor-auth
KEYCLOAK_ADMIN_URL=http://projeqtor/projeqtor-auth
