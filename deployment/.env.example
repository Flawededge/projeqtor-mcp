# Microsoft OAuth remains disabled until these values and the Entra secret file
# are configured. Then set COMPOSE_PROFILES=oauth and MCP_OAUTH_ENABLED=true.
# COMPOSE_PROFILES=oauth
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER=https://conceptpower.ddns.net/projeqtor-auth/realms/projeqtor
